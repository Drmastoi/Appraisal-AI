# PostgreSQL — production runs on Neon (UK/London region, via Vercel Marketplace).
# Local dev: copy .env from the main checkout, or point DATABASE_URL at any Postgres.
# Neon uses a pooled URL for DATABASE_URL (runtime) and the direct URL for migrations.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/db?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/db?sslmode=require"

# Session signing / hashing secret (change in any real deployment)
AUTH_SECRET="dev-only-secret-change-me"

# Optional: Postgres URL for the opt-in e2e lifecycle test (tests/e2e-lifecycle.test.ts).
# Use a disposable database — the test writes and deletes its own rows.
# TEST_DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# AI provider configuration (abstraction layer):
# provider: "mock" (default, deterministic) | "azure-openai" | "openai"
AI_PROVIDER="mock"
AI_MODEL=""
# Azure OpenAI (UK region) when AI_PROVIDER=azure-openai
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT=""
# OpenAI when AI_PROVIDER=openai
OPENAI_API_KEY=""
